{
  "name": "@flegartech/youtube-focus",
  "version": "1.0.0",
  "description": "Distraction-free YouTube productivity engine, algorithmic feed interceptor, and intent-driven focus session platform.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "extension:install": "npm ci --prefix extension",
    "extension:validate": "npm run validate --prefix extension",
    "extension:build": "npm run build --prefix extension",
    "extension:package": "npm run package --prefix extension",
    "extension:test": "npm run test:extension --prefix extension"
  },
  "keywords": [
    "productivity",
    "focus",
    "youtube-blocker",
    "pomodoro",
    "chrome-extension",
    "typescript",
    "zod"
  ],
  "author": "FlegarTech <dev@flegartech.com>",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.308",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "10.12.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "8.71.2",
    "vite": "^6.1.0",
    "vitest": "4.1.11"
  }
}
