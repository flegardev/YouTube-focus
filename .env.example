# YouTube Focus Environment Configuration

# Server & Dashboard Port
VITE_APP_PORT=3005
VITE_APP_ENV=development

# Chrome Extension ID (when loaded unpacked)
VITE_CHROME_EXTENSION_ID=abcdefghijklmnopabcdefghijklmnop

# Default Focus Duration (Minutes)
VITE_DEFAULT_FOCUS_MINUTES=25
VITE_DEFAULT_BREAK_MINUTES=5

# Distraction Threshold (Max allowed entertainment minutes per day)
VITE_DAILY_ENTERTAINMENT_BUDGET_MINUTES=45
